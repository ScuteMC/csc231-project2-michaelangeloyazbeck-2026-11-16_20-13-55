  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.92, g: 0.94, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 10102, guid: 0000000000000000e000000000000000, type: 0}
    m_FontSize: 17
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "THE WORLD \u2014 NOCTIS REACH:\nSuspended above the moonlit Twilight Canal,
    Noctis Reach runs on condensed dawnlight stored inside golden\nDistrict Lanterns.
    Tonight, the Eternal Eclipse struck the high Sanctum Spire, shattering its central
    crystal.\n\nVESPER'S BACKSTORY & CAUSE:\nYou play as Vesper, youngest of the
    Shadow-Stitchers\u2014high-altitude couriers entrusted with the dusk-woven Cloak.\nOnly
    Vesper can soar across severed bridges, awaken dormant Watchtower Lanterns, and
    save the sleeping city below.\n\nYOUR OBJECTIVE ACROSS 4 DISTRICTS:\n1. Courtyard
    of Whispers  ->  2. Gale-Draft Aqueduct  ->  3. Clockwork Foundry  ->  4. Twilight
    Sanctum\nReclaim all 25 scattered Memory Shards, outwit Sentinel drones & ambush
    spikes, and ignite the Sanctum Beacon!"
